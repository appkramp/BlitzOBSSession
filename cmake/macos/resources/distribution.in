<?xml version="1.0" encoding="utf-8" standalone="no"?>
<installer-gui-script minSpecVersion="1.0">
    <options
        rootVolumeOnly="true"
        hostArchitectures="arm64,x86_64"
        customize="never"
        allow-external-scripts="no" />
    <domains enable_currentUserHome="true" enable_anywhere="false" enable_localSystem="false" />
    <title>@CMAKE_PROJECT_NAME@</title>
    <choices-outline>
        <line choice="obs-plugin" />
    </choices-outline>
    <choice id="obs-plugin" title="@CMAKE_PROJECT_NAME@" description="">
        <pkg-ref id="@MACOS_BUNDLEID@" />
    </choice>
    <pkg-ref id="@MACOS_BUNDLEID@" version="@CMAKE_PROJECT_VERSION@">#@CMAKE_PROJECT_NAME@.pkg</pkg-ref>
    <installation-check script="installCheck();" />
    <script><![CDATA[
        function installCheck() {
            var macOSVersion = system.version.ProductVersion

            if (system.compareVersions(macOSVersion, '@CMAKE_OSX_DEPLOYMENT_TARGET@') == -1) {
                my.result.title = system.localizedStandardStringWithFormat(
                                    'InstallationCheckError',
                                    system.localizedString('DISTRIBUTION_TITLE')
                                  );
                my.result.message = ' ';
                my.result.type = 'Fatal';
                return false;
            }

            // An installed copy: say what happens to it — updated, installed
            // again, or replaced by an older version — and let the user go
            // on or stop. Its files are replaced wholesale (scripts/preinstall).
            var version = '@CMAKE_PROJECT_VERSION@';
            var plugin = system.env.HOME + '/Library/Application Support/obs-studio/plugins/@CMAKE_PROJECT_NAME@.plugin';
            var message = null;
            if (system.files.fileExistsAtPath(plugin)) {
                var bundle = system.files.bundleAtPath(plugin);
                var installed = bundle ? bundle.CFBundleShortVersionString : null;
                if (!installed) {
                    message = system.localizedStringWithFormat('Unknown', version);
                } else {
                    var order = system.compareVersions(installed, version);
                    if (order < 0)
                        message = system.localizedStringWithFormat('Upgrade', installed, version);
                    else if (order == 0)
                        message = system.localizedStringWithFormat('Same', installed);
                    else
                        message = system.localizedStringWithFormat('Newer', installed, version);
                }
            }
            var obs = system.applications.fromIdentifier('com.obsproject.obs-studio');
            if (obs && obs.length > 0)
                message = (message ? message + '\n\n' : '') + system.localizedString('CloseObs');
            if (message) {
                my.result.title = system.localizedString('Title');
                my.result.message = message;
                my.result.type = 'Warning';
                return false;
            }
            return true;
        }
    ]]></script>
</installer-gui-script>
